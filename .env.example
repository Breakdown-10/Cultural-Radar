# Culture Radar Environment Configuration

# -------------------------------------------------------------
# Qloo Cultural Intelligence API Configuration
# -------------------------------------------------------------
# Request an API key at https://docs.qloo.com/reference/api-overview
# For Hackathon participants: keys work against https://hackathon.api.qloo.com
QLOO_API_KEY=your_qloo_api_key_here
QLOO_BASE_URL=https://hackathon.api.qloo.com

# -------------------------------------------------------------
# Google Gemini LLM Configuration (@ai-sdk/google)
# -------------------------------------------------------------
# Get your Google AI Studio key at https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# -------------------------------------------------------------
# Application Settings
# -------------------------------------------------------------
# Set to 'true' to force mock fixtures when testing without live API keys
USE_MOCK_FALLBACK=false
